<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050811"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CONTRATO DIGITAL FAMILIAR"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tomás Morales (Hijo) ⇄ Ricardo Morales (Padre)"
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#0F172A"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtScoreMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Meta Pactada: 88 Puntos"
            android:textColor="#34D399"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <SeekBar
            android:id="@+id/seekScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="53"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Geocercas: Campus UTP • Cerro Colorado • Polideportivo"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:layout_marginTop="12dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnFirmar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="CONFIRMAR Y FIRMAR CONTRATO"
        android:backgroundTint="#4F46E5"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
