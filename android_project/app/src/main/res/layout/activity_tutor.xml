<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050811"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MODO TUTOR: Ricardo Morales"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Paz Mental Parental • Cero Espionaje GPS"
        android:textColor="#34D399"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <!-- Peace of Mind Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="#0F172A"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LLEGADA SEGURA CONFIRMADA [OK]"
            android:textColor="#34D399"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDestino"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Destino: Campus UTP (Arequipa)"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/txtHora"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hora: 19:45 hrs (A tiempo)"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Dispositivo Móvil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#0F172A"
        android:padding="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtBateria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Batería Smartphone: 84%"
            android:textColor="#34D399"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtFrenos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pastillas de freno al 75% de vida útil"
            android:textColor="#E2E8F0"
            android:textSize="11sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnAprobarPrestamo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="APROBAR PRÉSTAMO FIN DE SEMANA"
        android:backgroundTint="#10B981"
        android:textColor="#000000"
        android:textStyle="bold" />

</LinearLayout>
