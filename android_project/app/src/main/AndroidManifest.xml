<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ford.safeteen">

    <!-- Permisos requeridos para conectividad vehicular y alertas hápticas -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="Ford SafeTeen Co-Drive"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Actividad Principal: Dashboard Conductor Joven (Tomás Morales) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Actividades de Tutor, Inclusivo, Contrato y Cabina SYNC 4 -->
        <activity android:name=".TutorActivity" android:exported="false" />
        <activity android:name=".InclusivoActivity" android:exported="false" />
        <activity android:name=".ContratoActivity" android:exported="false" />
        <activity android:name=".Sync4Activity" android:exported="false" />

    </application>

</manifest>
